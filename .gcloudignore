.git
.gitignore
.gcloudignore

# Logs and debugs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and builds
node_modules
dist
dist-ssr

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.env
.venv
venv/
ENV/
env/

# IDE files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*service-account.json

# Explicitly ensure start.sh is included even if in .gitignore
!start.sh
